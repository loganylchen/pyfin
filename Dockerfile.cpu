# --- Build stage ---
FROM python:3.11-slim AS builder

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential zlib1g-dev libhdf5-dev \
    wget ca-certificates git \
    && rm -rf /var/lib/apt/lists/*

# Install krill signal backend (in-memory eventalign + DTW, CPU) plus signal IO
# deps. krill replaces the legacy f5c_rna wheel and f5c CLI binary; pip picks the
# cp311 manylinux wheel to match python:3.11-slim. --no-deps keeps the custom
# index from resolving numpy/etc (those arrive with the pyfin install below).
RUN pip install --no-cache-dir pyslow5 pyfastx \
    && pip install --no-cache-dir "krill==0.1.5" --no-deps \
        --index-url https://loganylchen.github.io/krill-dist/simple/

# Install pyfin (CPU only — no nvcc, so setup.py skips CUDA extension)
WORKDIR /app
COPY . .
RUN pip install --no-cache-dir .

# --- Runtime stage ---
FROM python:3.11-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends zlib1g \
    && apt-cache search '^libhdf5-[0-9]' | head -1 | awk '{print $1}' \
       | xargs apt-get install -y --no-install-recommends \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /usr/local/lib/python3.11/site-packages /usr/local/lib/python3.11/site-packages
COPY --from=builder /usr/local/bin/fin /usr/local/bin/fin

WORKDIR /data
