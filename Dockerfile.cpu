# --- Build stage ---
FROM python:3.11-slim AS builder

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential zlib1g-dev libhdf5-dev \
    wget ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Install pyfin (CPU only — no nvcc, so setup.py skips CUDA extension)
WORKDIR /app
COPY . .
RUN pip install --no-cache-dir .

# Fetch prebuilt f5c CPU binary
ARG F5C_VERSION=1.5
RUN wget -q "https://github.com/hasindu2008/f5c/releases/download/v${F5C_VERSION}/f5c-v${F5C_VERSION}-binaries.tar.gz" \
        -O /tmp/f5c.tar.gz \
    && tar -xzf /tmp/f5c.tar.gz -C /tmp \
    && install -m 0755 "/tmp/f5c-v${F5C_VERSION}/f5c_x86_64_linux" /usr/local/bin/f5c \
    && rm -rf /tmp/f5c.tar.gz "/tmp/f5c-v${F5C_VERSION}"

# --- Runtime stage ---
FROM python:3.11-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends zlib1g \
    && apt-cache search '^libhdf5-[0-9]' | head -1 | awk '{print $1}' \
       | xargs apt-get install -y --no-install-recommends \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /usr/local/lib/python3.11/site-packages /usr/local/lib/python3.11/site-packages
COPY --from=builder /usr/local/bin/f5c /usr/local/bin/f5c

WORKDIR /data
