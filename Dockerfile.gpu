# --- Build stage ---
FROM nvidia/cuda:12.2.2-devel-ubuntu22.04 AS builder

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 python3-pip python3-dev python3-venv \
    wget build-essential zlib1g-dev libhdf5-dev \
    && rm -rf /var/lib/apt/lists/*

# Install krill signal backend (in-memory eventalign + DTW) plus signal IO deps.
# We install the CPU-only krill wheel ON PURPOSE: a GPU (cu122) krill build EXISTS
# (`.../krill-dist/cu122/simple/`, `krill==<ver>+cu122`), but measurement showed it
# is NOT faster for pyfin — the DTW compute is break-even (many SMALL per-interval
# DTW calls) and, with N interval-worker processes on a many-core host, CPU krill
# parallelises across cores while GPU krill funnels every small call through one
# device (+ a one-time CUDA/JIT warmup). GPU only wins on few LARGE batched DTW
# calls, so a real GPU-DTW speedup needs pyfin-side DTW batching first. The EM step
# is still GPU-accelerated via cupy below. --no-deps keeps the custom index from
# resolving numpy/etc (those arrive with pyfin).
RUN pip3 install --no-cache-dir pyslow5 pyfastx \
    && pip3 install --no-cache-dir "krill==0.1.5" --no-deps \
        --index-url https://loganylchen.github.io/krill-dist/simple/

# Install pyfin and CUDA-12 prebuilt cupy wheel (avoids 30 min source build).
# CuPy JIT-compiles the EM elementwise kernels at runtime via NVRTC, which needs
# CUDA headers. The slim -runtime base has none (they live only in -devel), so on
# the plain wheel the first cupy ufunc dies with "Failed to find CUDA headers".
# Supply the headers via the pip-packaged NVRTC + cudart wheels, pinned to 12.2.*
# to match the CUDA 12.2 base (avoids the broad cupy-cuda12x[ctk] umbrella, whose
# unpinned component wheels would drift from the base and bloat the image). CuPy's
# pathfinder discovers these under site-packages/nvidia/*; they install into
# dist-packages and are carried into the runtime stage by the COPY below.
WORKDIR /app
COPY . .
RUN pip3 install --no-cache-dir cupy-cuda12x \
        "nvidia-cuda-nvrtc-cu12==12.2.*" "nvidia-cuda-runtime-cu12==12.2.*" \
        numba \
    && pip3 install --no-cache-dir .

# Record Python version for runtime stage verification
RUN python3 -c 'import sys; print(f"{sys.version_info.major}.{sys.version_info.minor}")' \
    > /tmp/python_version.txt

# --- Runtime stage ---
FROM nvidia/cuda:12.2.2-runtime-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
    && apt-get install -y --no-install-recommends python3 python3-pip zlib1g \
    && apt-cache search '^libhdf5-[0-9]' | head -1 | awk '{print $1}' \
       | xargs apt-get install -y --no-install-recommends \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /tmp/python_version.txt /tmp/python_version.txt

# Copy installed Python packages (Ubuntu 22.04 ships Python 3.10)
COPY --from=builder /usr/local/lib/python3.10/dist-packages /usr/local/lib/python3.10/dist-packages
COPY --from=builder /usr/lib/python3/dist-packages /usr/lib/python3/dist-packages

# Console script installed by pip
COPY --from=builder /usr/local/bin/fin /usr/local/bin/fin

# Verify Python versions match between builder and runtime
RUN BUILD_VER=$(cat /tmp/python_version.txt) \
    && RUNTIME_VER=$(python3 -c 'import sys; print(f"{sys.version_info.major}.{sys.version_info.minor}")') \
    && if [ "$BUILD_VER" != "$RUNTIME_VER" ]; then \
         echo "ERROR: Python version mismatch: builder=$BUILD_VER runtime=$RUNTIME_VER" >&2; \
         echo "Update the COPY paths in Dockerfile.gpu to match python$RUNTIME_VER" >&2; \
         exit 1; \
       fi \
    && rm /tmp/python_version.txt

# CuPy NVRTC kernel cache. Default location is $HOME/.cupy, but containers
# launched with `--user $(id -u)` map to a UID whose HOME is "/" (unwritable),
# so the first cupy ufunc (e.g. EM step) crashes with PermissionError on
# "/.cupy". Point cache at a world-writable path so any UID can populate it.
# First run JIT-compiles ~5 small kernels (~10–25s); subsequent runs hit cache.
ENV CUPY_CACHE_DIR=/tmp/cupy-cache
RUN mkdir -p /tmp/cupy-cache && chmod 1777 /tmp/cupy-cache

WORKDIR /data
